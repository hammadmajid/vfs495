[Unit]
Description=VFS495 fingerprint sensor feeder (open driver -> libfprint virtual_image)
Documentation=https://github.com/hammadmajid/vfs495

[Service]
# Idle until fprintd is waiting for a finger, then capture one swipe and feed it.
ExecStart=/usr/local/bin/vfs495 --base /usr/local/share/vfs495 daemon --fprintd --socket /var/lib/fprint/vfs495.sock
# Caps Lock LED lights while the sensor is recording: swipe then.
Environment=VFS_CUE_LED=capslock
Environment=RUST_LOG=warn,vfs495=info,vfs495::capture=warn,vfs495::session=warn
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
